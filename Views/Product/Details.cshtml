@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;
    var gallery = product.Images.OrderBy(i => i.DisplayOrder).Select(i => i.ImageUrl).Distinct().ToList();
    if (!gallery.Any() && product.MainImage != null) gallery.Add(product.MainImage);
}

<section class="detail-page">
    <div class="container">
        <div class="detail-grid">
            <div class="gallery">
                <div class="gallery-main">
                    <img id="mainImage" src="@(gallery.FirstOrDefault() ?? product.MainImage)" alt="@product.Name" />
                </div>
                @if (gallery.Count > 1)
                {
                    <div class="thumbs">
                        @foreach (var img in gallery)
                        {
                            <button type="button" class="thumb" data-src="@img"><img src="@img" alt="" /></button>
                        }
                    </div>
                }
            </div>
            <div class="detail-info">
                <p class="eyebrow">@product.Category.Name</p>
                <h1>@product.Name</h1>
                <div class="product-price xl">
                    <strong>@FormatHelper.Vnd(product.DisplayPrice)</strong>
                    @if (product.IsOnSale)
                    {
                        <s>@FormatHelper.Vnd(product.Price)</s>
                    }
                </div>
                <p class="lead">@product.ShortDescription</p>
                <p class="stock @(product.InStock ? "in" : "out")">@(product.InStock ? $"Còn {product.Stock} sản phẩm" : "Hết hàng")</p>

                <form asp-controller="Cart" asp-action="Add" method="post" class="buy-box js-add-cart">
                    <input type="hidden" name="productId" value="@product.Id" />

                    @if (Model.Colors.Any())
                    {
                        <div class="option-group">
                            <label>Màu sắc</label>
                            <div class="option-pills">
                                @for (var i = 0; i < Model.Colors.Count; i++)
                                {
                                    <label class="pill">
                                        @if (i == 0)
                                        {
                                            <input type="radio" name="color" value="@Model.Colors[i]" checked />
                                        }
                                        else
                                        {
                                            <input type="radio" name="color" value="@Model.Colors[i]" />
                                        }
                                        <span>@Model.Colors[i]</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.Storages.Any())
                    {
                        <div class="option-group">
                            <label>Dung lượng</label>
                            <div class="option-pills">
                                @for (var i = 0; i < Model.Storages.Count; i++)
                                {
                                    <label class="pill">
                                        @if (i == 0)
                                        {
                                            <input type="radio" name="storage" value="@Model.Storages[i]" checked />
                                        }
                                        else
                                        {
                                            <input type="radio" name="storage" value="@Model.Storages[i]" />
                                        }
                                        <span>@Model.Storages[i]</span>
                                    </label>
                                }
                            </div>
                        </div>
                    }

                    <div class="qty-row">
                        <label>Số lượng</label>
                        <input class="form-control qty" type="number" name="quantity" value="1" min="1" max="@product.Stock" />
                    </div>
                    <button class="btn-primary lg w-100" type="submit" disabled="@(!product.InStock)">
                        @(product.InStock ? "Thêm vào giỏ hàng" : "Hết hàng")
                    </button>
                </form>
            </div>
        </div>

        <div class="detail-tabs">
            <div>
                <h2>Mô tả</h2>
                <p>@product.Description</p>
            </div>
            <div>
                <h2>Thông số kỹ thuật</h2>
                <ul class="spec-list">
                    @foreach (var line in (product.Specifications ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        var parts = line.Split(':', 2);
                        <li><span>@parts[0]</span><strong>@(parts.Length > 1 ? parts[1] : "")</strong></li>
                    }
                </ul>
            </div>
        </div>

        @if (Model.RelatedProducts.Any())
        {
            <div class="section-head mt-5">
                <h2>Sản phẩm liên quan</h2>
            </div>
            <div class="product-grid">
                @foreach (var item in Model.RelatedProducts)
                {
                    <partial name="_ProductCard" model="item" />
                }
            </div>
        }
    </div>
</section>
