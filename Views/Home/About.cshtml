@{
    ViewData["Title"] = "Về chúng tôi";
}

<section class="page-hero gradient-hero">
    <div class="container">
        <p class="eyebrow light">iStore</p>
        <h1>Chúng tôi mang Apple đến gần hơn với bạn</h1>
        <p class="lead light">iStore đã đồng hành cùng hàng nghìn khách hàng Việt trên hành trình khám phá hệ sinh thái Apple.</p>
    </div>
</section>

<section class="section">
    <div class="container about-grid">
        <div class="reveal">
            <p class="eyebrow gradient-text">Câu chuyện</p>
            <h2>Tinh giản. Chân thành. Đúng nghĩa Apple.</h2>
            <p class="muted">iStore được thành lập với niềm tin công nghệ nên đến với mọi người theo cách rõ ràng nhất. Chúng tôi cung cấp sản phẩm Apple chính hãng, tư vấn tận tâm và dịch vụ hậu mãi minh bạch.</p>
            <p class="muted">Đội ngũ chúng tôi tin rằng: một chiếc iPhone không chỉ là điện thoại, một chiếc MacBook không chỉ là máy tính — đó là công cụ giúp bạn hiện thực hóa ý tưởng.</p>
        </div>
        <div class="reveal about-image">
            <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1200&q=80&auto=format&fit=crop" alt="iStore team" />
        </div>
    </div>
</section>

<section class="section gradient-band">
    <div class="container">
        <div class="stats-row">
            <div class="stat-item reveal"><strong>10K+</strong><span>Khách hàng đã tin tưởng</span></div>
            <div class="stat-item reveal"><strong>24/7</strong><span>Hỗ trợ trực tuyến</span></div>
            <div class="stat-item reveal"><strong>12</strong><span>Tháng bảo hành chính hãng</span></div>
            <div class="stat-item reveal"><strong>100%</strong><span>Sản phẩm chính hãng</span></div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head text-center">
            <p class="eyebrow gradient-text">Giá trị cốt lõi</p>
            <h2>Điều làm iStore khác biệt</h2>
        </div>
        <div class="value-grid">
            <div class="value-card c1 reveal">
                <i class="bi bi-patch-check-fill"></i>
                <h3>Chính hãng 100%</h3>
                <p>Nguồn hàng nhập khẩu chính ngạch, đầy đủ hóa đơn VAT.</p>
            </div>
            <div class="value-card c2 reveal">
                <i class="bi bi-truck"></i>
                <h3>Giao hàng nhanh</h3>
                <p>2 giờ trong nội thành và 1–2 ngày cho toàn quốc.</p>
            </div>
            <div class="value-card c3 reveal">
                <i class="bi bi-tools"></i>
                <h3>Dịch vụ tận tâm</h3>
                <p>Tư vấn 1-1 và hỗ trợ kỹ thuật miễn phí trọn đời.</p>
            </div>
            <div class="value-card c4 reveal">
                <i class="bi bi-cash-coin"></i>
                <h3>Giá tốt mỗi ngày</h3>
                <p>Cam kết giá cạnh tranh và trả góp 0% qua thẻ tín dụng.</p>
            </div>
        </div>
    </div>
</section>
