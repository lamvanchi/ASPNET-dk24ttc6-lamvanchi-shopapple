@model Category
@{
    ViewData["Title"] = "Sửa danh mục";
}
<div class="admin-card form-narrow">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Icon" />
        <div class="mb-3">
            <label asp-for="Name">Tên</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Slug"></label>
            <input asp-for="Slug" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="Description">Mô tả</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="DisplayOrder">Thứ tự</label>
            <input asp-for="DisplayOrder" class="form-control" />
        </div>
        <label class="check-row"><input asp-for="IsActive" /> Kích hoạt</label>
        <div class="mt-3">
            <button class="btn-primary" type="submit">Cập nhật</button>
            <a class="btn-ghost" asp-action="Index">Hủy</a>
        </div>
    </form>
</div>
