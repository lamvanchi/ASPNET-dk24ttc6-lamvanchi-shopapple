@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Tài khoản</p>
        <h1>Lịch sử đơn hàng</h1>
    </div>
</section>

<section class="section tight">
    <div class="container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-receipt"></i>
                <h3>Chưa có đơn hàng</h3>
                <a class="btn-primary" asp-controller="Product" asp-action="Index">Bắt đầu mua sắm</a>
            </div>
        }
        else
        {
            <div class="table-card">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mã đơn</th>
                            <th>Ngày đặt</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>@order.OrderCode</strong></td>
                                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@FormatHelper.Vnd(order.TotalAmount)</td>
                                <td><span class="status-badge @FormatHelper.StatusClass(order.Status)">@FormatHelper.StatusText(order.Status)</span></td>
                                <td><a asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
