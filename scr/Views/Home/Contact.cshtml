@{
    ViewData["Title"] = "Liên hệ";
}

<section class="page-hero gradient-hero">
    <div class="container">
        <p class="eyebrow light">Liên hệ</p>
        <h1>Chúng tôi luôn ở đây để hỗ trợ bạn</h1>
        <p class="lead light">Gửi tin nhắn hoặc ghé cửa hàng — đội ngũ iStore luôn sẵn sàng.</p>
    </div>
</section>

<section class="section">
    <div class="container contact-grid">
        <div class="contact-info reveal">
            <div class="info-item"><span><i class="bi bi-geo-alt"></i></span><div><h4>Địa chỉ</h4><p>Quận 9, Hồ Chí Minh</p></div></div>
            <div class="info-item"><span><i class="bi bi-telephone"></i></span><div><h4>Hotline</h4><p>0942473373</p></div></div>
            <div class="info-item"><span><i class="bi bi-envelope"></i></span><div><h4>Email</h4><p>chilv200693@tvu-onschool.edu.vn</p></div></div>
            <div class="info-item"><span><i class="bi bi-clock"></i></span><div><h4>Giờ mở cửa</h4><p>8:00 – 22:00 mỗi ngày</p></div></div>
        </div>
        <div class="auth-card contact-card reveal">
            <h2>Gửi tin nhắn cho chúng tôi</h2>
            <form method="post">
                <div class="mb-3">
                    <label>Họ tên</label>
                    <input class="form-control" name="name" required />
                </div>
                <div class="mb-3">
                    <label>Email</label>
                    <input type="email" class="form-control" name="email" required />
                </div>
                <div class="mb-3">
                    <label>Nội dung</label>
                    <textarea class="form-control" name="message" rows="5" required></textarea>
                </div>
                <button class="btn-primary lg w-100" type="submit"><i class="bi bi-send"></i> Gửi tin nhắn</button>
            </form>
        </div>
    </div>
</section>
