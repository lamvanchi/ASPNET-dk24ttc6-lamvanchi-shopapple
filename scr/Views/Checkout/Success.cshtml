@{
    ViewData["Title"] = "Đặt hàng thành công";
}
<section class="page-wrap">
    <div class="container">
        <div class="empty-state success">
            <i class="bi bi-check-circle"></i>
            <h1>Cảm ơn bạn đã đặt hàng</h1>
            <p>Mã đơn của bạn là <strong>@ViewBag.OrderCode</strong>. Chúng tôi sẽ liên hệ để xác nhận và giao hàng.</p>
            <div class="hero-cta justify-content-center">
                <a class="btn-primary" asp-controller="Order" asp-action="Index">Xem đơn hàng</a>
                <a class="btn-ghost" asp-controller="Home" asp-action="Index">Về trang chủ</a>
            </div>
        </div>
    </div>
</section>
