@model ProductListViewModel
@{
    ViewData["Title"] = Model.CategoryName ?? (string.IsNullOrEmpty(Model.Keyword) ? "Cửa hàng" : $"Tìm \"{Model.Keyword}\"");
}

<section class="page-hero">
    <div class="container">
        <p class="eyebrow">Cửa hàng</p>
        <h1>@(Model.CategoryName ?? (string.IsNullOrEmpty(Model.Keyword) ? "Tất cả sản phẩm" : $"Kết quả cho “{Model.Keyword}”"))</h1>
        <p class="muted">@Model.TotalItems sản phẩm</p>
    </div>
</section>

<section class="section tight">
    <div class="container">
        <form method="get" class="filter-bar">
            <input type="hidden" name="q" value="@Model.Keyword" />
            <select name="categoryId" class="form-select">
                <option value="">Tất cả danh mục</option>
                @foreach (var cat in Model.Categories)
                {
                    if (Model.CategoryId == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Name</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
            <input class="form-control" type="number" name="minPrice" value="@Model.MinPrice" placeholder="Giá từ" />
            <input class="form-control" type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="Giá đến" />
            <select name="sort" class="form-select" asp-for="Sort" asp-items="Model.SortOptions"></select>
            <button class="btn-primary" type="submit">Lọc</button>
        </form>

        @if (!Model.Products.Any())
        {
            <div class="empty-state">
                <i class="bi bi-bag"></i>
                <h3>Không tìm thấy sản phẩm</h3>
                <p>Thử đổi từ khóa hoặc bỏ bộ lọc.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model.Products)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="pager">
                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        <a class="@(i == Model.Page ? "active" : null)"
                           asp-action="Index"
                           asp-route-q="@Model.Keyword"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-minPrice="@Model.MinPrice"
                           asp-route-maxPrice="@Model.MaxPrice"
                           asp-route-sort="@Model.Sort"
                           asp-route-page="@i">@i</a>
                    }
                </nav>
            }
        }
    </div>
</section>
