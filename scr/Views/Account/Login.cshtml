@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">iStore</p>
        <h1>Đăng nhập</h1>
        <p class="muted">Sử dụng email và mật khẩu của bạn.</p>
        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="you@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <label class="check-row">
                <input asp-for="RememberMe" /> Ghi nhớ đăng nhập
            </label>
            <button class="btn-primary lg w-100 mt-3" type="submit">Đăng nhập</button>
        </form>
        <p class="auth-foot">Chưa có tài khoản? <a asp-action="Register">Tạo tài khoản</a></p>
        <div class="demo-box">
            <p><strong>Tài khoản demo</strong></p>
            <p>Admin: admin@istore.vn / Admin@123</p>
            <p>User: user@istore.vn / User@123</p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
