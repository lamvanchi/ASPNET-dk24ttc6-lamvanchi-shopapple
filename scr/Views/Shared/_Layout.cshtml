@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string ActiveIf(string ctrl, string? act = null) =>
        currentController == ctrl && (act == null || currentAction == act) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "iStore") — Cửa hàng Apple chính hãng</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()

    <div class="marquee-bar">
        <div class="marquee-inner">
            <span><i class="bi bi-truck"></i> Miễn phí giao hàng toàn quốc</span>
            <span><i class="bi bi-shield-check"></i> Bảo hành chính hãng 12 tháng</span>
            <span><i class="bi bi-credit-card-2-back"></i> Trả góp 0% qua thẻ tín dụng</span>
            <span><i class="bi bi-headset"></i> Hotline 0942473373</span>
            <span><i class="bi bi-envelope"></i>Email: chilv200693@tvu-onschool.edu.vn</span>
        </div>
    </div>

    <header class="site-header" id="siteHeader">
        <div class="container header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo"><i class="bi bi-apple"></i></span>
                <span class="brand-text">iStore</span>
            </a>

            <button class="nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="collapse main-nav" id="mainNav">
                <ul class="nav-links">
                    <li><a class="@ActiveIf("Home", "Index")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Trang chủ</a></li>
                    <li class="has-menu">
                        <a href="#" class="@ActiveIf("Product")"><i class="bi bi-grid-3x3-gap"></i> Sản phẩm <i class="bi bi-chevron-down chev"></i></a>
                        <div class="mega-menu">
                            <div class="mega-col">
                                <h6>iPhone</h6>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="iphone-17">iPhone 17</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="iphone-17-pro">iPhone 17 Pro</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="iphone-17-pro-max">iPhone 17 Pro Max</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="iphone-air">iPhone Air</a>
                                <a class="see-all" asp-controller="Product" asp-action="Index" asp-route-category="iphone">Xem tất cả →</a>
                            </div>
                            <div class="mega-col">
                                <h6>Mac</h6>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="macbook-air-13">MacBook Air 13"</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="macbook-air-15">MacBook Air 15"</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="macbook-pro-14">MacBook Pro 14"</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="macbook-pro-16">MacBook Pro 16"</a>
                                <a class="see-all" asp-controller="Product" asp-action="Index" asp-route-category="macbook">Xem tất cả →</a>
                            </div>
                            <div class="mega-col">
                                <h6>iPad & Watch</h6>
                                <a asp-controller="Product" asp-action="Index" asp-route-category="ipad">iPad</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="ipad-pro">iPad Pro</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="apple-watch-series-11">Apple Watch Series 11</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="apple-watch-ultra-2">Apple Watch Ultra 2</a>
                                <a class="see-all" asp-controller="Product" asp-action="Index" asp-route-category="apple-watch">Xem tất cả →</a>
                            </div>
                            <div class="mega-col">
                                <h6>AirPods & Phụ kiện</h6>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="airpods-4">AirPods 4</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="airpods-pro-2">AirPods Pro 2</a>
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="airpods-max">AirPods Max</a>
                                <a asp-controller="Product" asp-action="Index" asp-route-category="phu-kien">Phụ kiện</a>
                                <a class="see-all" asp-controller="Product" asp-action="Index">Toàn bộ cửa hàng →</a>
                            </div>
                        </div>
                    </li>
                    <li><a class="@ActiveIf("Home", "About")" asp-controller="Home" asp-action="About"><i class="bi bi-info-circle"></i> Về chúng tôi</a></li>
                    <li><a class="@ActiveIf("Home", "Contact")" asp-controller="Home" asp-action="Contact"><i class="bi bi-telephone"></i> Liên hệ</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li><a class="@ActiveIf("Order")" asp-controller="Order" asp-action="Index"><i class="bi bi-bag-check"></i> Đơn hàng</a></li>
                    }
                </ul>

                <form class="header-search" asp-controller="Product" asp-action="Index" method="get">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="Tìm iPhone, MacBook, AirPods..." />
                </form>

                <div class="header-actions">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var currentUser = await UserManager.GetUserAsync(User);
                        var initial = string.IsNullOrEmpty(currentUser?.FullName) ? "U" : currentUser.FullName[..1].ToUpper();
                        <div class="dropdown user-dropdown">
                            <button class="user-btn dropdown-toggle" data-bs-toggle="dropdown">
                                <span class="avatar">@initial</span>
                                <span class="d-none d-xl-inline">@currentUser?.FullName</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Thông tin</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Index"><i class="bi bi-bag"></i> Đơn hàng của tôi</a></li>
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="ChangePassword"><i class="bi bi-key"></i> Đổi mật khẩu</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Trang quản trị</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item" type="submit"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="link-btn" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
                        <a class="btn-primary sm" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    }
                    <a class="cart-link" asp-controller="Cart" asp-action="Index" title="Giỏ hàng">
                        <i class="bi bi-bag"></i>
                        <span class="cart-badge" id="cartCount">@await Component.InvokeAsync("CartCount")</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-top">
                <div class="footer-brand">
                    <div class="brand">
                        <span class="brand-logo"><i class="bi bi-apple"></i></span>
                        <span class="brand-text">iStore</span>
                    </div>
                    <p>Nhà bán lẻ Apple ủy quyền tại Việt Nam. Thiết bị chính hãng, bảo hành toàn cầu.</p>
                    <div class="socials">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="footer-col">
                    <h6>Cửa hàng</h6>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="iphone">iPhone</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="macbook">MacBook</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="ipad">iPad</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="apple-watch">Apple Watch</a>
                    <a asp-controller="Product" asp-action="Index" asp-route-category="airpods">AirPods</a>
                </div>
                <div class="footer-col">
                    <h6>Hỗ trợ</h6>
                    <a asp-controller="Home" asp-action="About">Về chúng tôi</a>
                    <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
                    <a asp-controller="Order" asp-action="Index">Theo dõi đơn hàng</a>
                    <a asp-controller="Cart" asp-action="Index">Giỏ hàng</a>
                    <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
                </div>
                <div class="footer-col">
                    <h6>Liên hệ</h6>
                    <p><i class="bi bi-geo-alt"></i> Quận 9, TP.HCM</p>
                    <p><i class="bi bi-telephone"></i> 0942473373</p>
                    <p><i class="bi bi-envelope"></i>chilv200693@tvu-onschool.edu.vn</p>
                    <p><i class="bi bi-clock"></i> 8:00 – 22:00 mỗi ngày</p>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© ĐẠI HỌC TRÀ VINH</span>
                <span>DK24TTC6 - LÂM VĂN CHỈ</span>
            </div>
        </div>
    </footer>

    <button class="scroll-top" id="scrollTop" title="Lên đầu trang"><i class="bi bi-arrow-up"></i></button>

    <div class="toast-wrap" id="toastWrap"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (TempData["Toast"] is string toast)
    {
        <script>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast)), "success");</script>
    }
    @if (TempData["ToastError"] is string toastError)
    {
        <script>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastError)), "error");</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
