@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}
<section class="page-wrap">
    <div class="container">
        <div class="empty-state">
            <h1>Đã xảy ra lỗi</h1>
            @if (Model.ShowRequestId)
            {
                <p class="muted">Mã: @Model.RequestId</p>
            }
            <a class="btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a>
        </div>
    </div>
</section>
