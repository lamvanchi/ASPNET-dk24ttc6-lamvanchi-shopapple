@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin") — iStore</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin-body">
    @{
        var adminUser = await UserManager.GetUserAsync(User);
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    }
    <aside class="admin-sidebar">
        <a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark">i</span>Store Admin</a>
        <nav>
            <a class="@(ctrl == "Dashboard" ? "active" : null)" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid"></i> Dashboard</a>
            <a class="@(ctrl == "Categories" ? "active" : null)" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-folder"></i> Danh mục</a>
            <a class="@(ctrl == "Products" ? "active" : null)" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-phone"></i> Sản phẩm</a>
            <a class="@(ctrl == "Orders" ? "active" : null)" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng</a>
            <a class="@(ctrl == "Customers" ? "active" : null)" asp-area="Admin" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Khách hàng</a>
            <a class="@(ctrl == "Statistics" ? "active" : null)" asp-area="Admin" asp-controller="Statistics" asp-action="Index"><i class="bi bi-graph-up"></i> Thống kê</a>
        </nav>
        <div class="sidebar-foot">
            <span>@adminUser?.FullName</span>
            <a asp-area="" asp-controller="Home" asp-action="Index">Về cửa hàng</a>
        </div>
    </aside>
    <div class="admin-main">
        <header class="admin-top">
            <h1>@(ViewData["Title"] ?? "Dashboard")</h1>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                <button class="btn-ghost" type="submit">Đăng xuất</button>
            </form>
        </header>
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
    <div class="toast-wrap" id="toastWrap"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (TempData["Toast"] is string toast)
    {
        <script>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toast)), "success");</script>
    }
    @if (TempData["ToastError"] is string toastError)
    {
        <script>showToast(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(toastError)), "error");</script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
