@model Order
@{
    ViewData["Title"] = Model.OrderCode;
}

<div class="admin-split">
    <div class="admin-card">
        <h2>Sản phẩm</h2>
        <table class="data-table">
            <thead><tr><th>Sản phẩm</th><th>SL</th><th>Đơn giá</th><th>Tổng</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Details)
            {
                <tr>
                    <td>
                        <strong>@item.ProductName</strong>
                        <div class="muted">@item.Color @item.Storage</div>
                    </td>
                    <td>@item.Quantity</td>
                    <td>@FormatHelper.Vnd(item.UnitPrice)</td>
                    <td>@FormatHelper.Vnd(item.LineTotal)</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="summary-row total mt-3"><span>Tổng đơn</span><strong>@FormatHelper.Vnd(Model.TotalAmount)</strong></div>
    </div>
    <div class="admin-card">
        <h2>Thông tin</h2>
        <p><strong>@Model.ReceiverName</strong></p>
        <p>@Model.Phone</p>
        <p>@Model.Address</p>
        <p class="muted">@Model.Note</p>
        <p>Thanh toán: @Model.PaymentMethod</p>
        <p>Trạng thái hiện tại: <span class="status-badge @FormatHelper.StatusClass(Model.Status)">@FormatHelper.StatusText(Model.Status)</span></p>
        <form asp-action="UpdateStatus" method="post" class="mt-3">
            <input type="hidden" name="id" value="@Model.Id" />
            <label>Cập nhật trạng thái</label>
            <select class="form-select mb-2" name="status" asp-items="FormatHelper.StatusOptions(Model.Status)"></select>
            <button class="btn-primary" type="submit">Lưu trạng thái</button>
        </form>
    </div>
</div>
