@model IEnumerable<Order>
@{
    ViewData["Title"] = "Đơn hàng";
}

<form method="get" class="filter-bar compact mb-3">
    <input class="form-control" name="q" value="@ViewBag.Keyword" placeholder="Mã đơn hoặc khách hàng..." />
    <select class="form-select" name="status" asp-items="ViewBag.StatusOptions">
        <option value="">Tất cả trạng thái</option>
    </select>
    <button class="btn-ghost" type="submit">Lọc</button>
</form>

<div class="admin-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Ngày</th>
                <th>Tổng</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td><strong>@order.OrderCode</strong></td>
                <td>@order.ReceiverName</td>
                <td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@FormatHelper.Vnd(order.TotalAmount)</td>
                <td><span class="status-badge @FormatHelper.StatusClass(order.Status)">@FormatHelper.StatusText(order.Status)</span></td>
                <td><a asp-action="Details" asp-route-id="@order.Id">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
