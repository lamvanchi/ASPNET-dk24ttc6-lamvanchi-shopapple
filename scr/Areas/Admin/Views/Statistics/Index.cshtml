@model StatisticsViewModel
@{
    ViewData["Title"] = "Thống kê";
}

<div class="stat-grid">
    <article class="stat-card"><span>Tổng doanh thu</span><strong>@FormatHelper.Vnd(Model.TotalRevenue)</strong></article>
    <article class="stat-card"><span>Tổng đơn hàng</span><strong>@Model.TotalOrders</strong></article>
    <article class="stat-card"><span>Sản phẩm đã bán</span><strong>@Model.ProductsSold</strong></article>
</div>

<div class="admin-card mb-4">
    <h2>Doanh thu theo tháng</h2>
    <canvas id="monthChart" height="110"></canvas>
</div>

<div class="admin-card">
    <h2>Sản phẩm bán chạy</h2>
    <table class="data-table">
        <thead><tr><th></th><th>Sản phẩm</th><th>Số lượng</th><th>Doanh thu</th></tr></thead>
        <tbody>
        @foreach (var item in Model.BestSellers)
        {
            <tr>
                <td><img class="thumb-sm" src="@item.Image" alt="" /></td>
                <td>@item.ProductName</td>
                <td>@item.QuantitySold</td>
                <td>@FormatHelper.Vnd(item.Revenue)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('monthChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
            datasets: [{
                label: 'Doanh thu',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues)),
                backgroundColor: '#1d1d1f',
                borderRadius: 8
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
</script>
}
