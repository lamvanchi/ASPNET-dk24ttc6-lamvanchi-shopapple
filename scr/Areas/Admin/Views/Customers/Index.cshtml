@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Khách hàng";
    var counts = ViewBag.OrderCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
}

<div class="admin-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Họ tên</th>
                <th>Email</th>
                <th>Điện thoại</th>
                <th>Ngày đăng ký</th>
                <th>Số đơn</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var user in Model)
        {
            counts.TryGetValue(user.Id, out var orderCount);
            <tr>
                <td><strong>@user.FullName</strong></td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td>@orderCount</td>
                <td><a asp-action="Details" asp-route-id="@user.Id">Chi tiết</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
