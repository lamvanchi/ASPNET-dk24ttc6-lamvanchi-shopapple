@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="stat-grid">
    <article class="stat-card"><span>Sản phẩm</span><strong>@Model.TotalProducts</strong></article>
    <article class="stat-card"><span>Khách hàng</span><strong>@Model.TotalCustomers</strong></article>
    <article class="stat-card"><span>Đơn hàng</span><strong>@Model.TotalOrders</strong></article>
    <article class="stat-card"><span>Doanh thu</span><strong>@FormatHelper.Vnd(Model.TotalRevenue)</strong></article>
    <article class="stat-card warn"><span>Chờ xử lý</span><strong>@Model.PendingOrders</strong></article>
    <article class="stat-card warn"><span>Sắp hết hàng</span><strong>@Model.LowStockProducts</strong></article>
</div>

<div class="admin-split">
    <div class="admin-card">
        <h2>Doanh thu 6 tháng</h2>
        <canvas id="revenueChart" height="120"></canvas>
    </div>
    <div class="admin-card">
        <h2>Đơn gần đây</h2>
        <table class="data-table">
            <tbody>
            @foreach (var order in Model.RecentOrders)
            {
                <tr>
                    <td><a asp-action="Details" asp-controller="Orders" asp-route-id="@order.Id">@order.OrderCode</a></td>
                    <td>@order.User.FullName</td>
                    <td>@FormatHelper.Vnd(order.TotalAmount)</td>
                    <td><span class="status-badge @FormatHelper.StatusClass(order.Status)">@FormatHelper.StatusText(order.Status)</span></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="admin-card mt-4">
    <h2>Sản phẩm sắp hết hàng</h2>
    <table class="data-table">
        <thead><tr><th>Sản phẩm</th><th>Danh mục</th><th>Tồn kho</th></tr></thead>
        <tbody>
        @foreach (var p in Model.LowStockList)
        {
            <tr>
                <td>@p.Name</td>
                <td>@p.Category.Name</td>
                <td><strong>@p.Stock</strong></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
    new Chart(document.getElementById('revenueChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartLabels)),
            datasets: [{
                label: 'Doanh thu',
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ChartValues)),
                borderColor: '#0071e3',
                backgroundColor: 'rgba(0,113,227,.12)',
                fill: true,
                tension: .35
            }]
        },
        options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
</script>
}
