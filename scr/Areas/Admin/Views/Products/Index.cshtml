@model IEnumerable<Product>
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="admin-toolbar">
    <form method="get" class="filter-bar compact">
        <input class="form-control" name="q" value="@ViewBag.Keyword" placeholder="Tìm sản phẩm..." />
        <select class="form-select" name="categoryId" asp-items="ViewBag.Categories">
            <option value="">Tất cả danh mục</option>
        </select>
        <button class="btn-ghost" type="submit">Tìm</button>
    </form>
    <a class="btn-primary" asp-action="Create">Thêm sản phẩm</a>
</div>

<div class="admin-card">
    <table class="data-table">
        <thead>
            <tr>
                <th></th>
                <th>Tên</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Tồn</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><img class="thumb-sm" src="@item.MainImage" alt="" /></td>
                <td><strong>@item.Name</strong></td>
                <td>@item.Category.Name</td>
                <td>@FormatHelper.Vnd(item.DisplayPrice)</td>
                <td>@item.Stock</td>
                <td>@(item.IsActive ? "Hiển thị" : "Ẩn")</td>
                <td class="table-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa sản phẩm này?');">
                        <button class="link-danger" type="submit">Xóa</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
