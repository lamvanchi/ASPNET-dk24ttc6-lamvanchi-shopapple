@model AdminProductViewModel
@{
    ViewData["Title"] = "Thêm sản phẩm";
}
<div class="admin-card form-wide">
    <form method="post" enctype="multipart/form-data">
        <partial name="_ProductForm" model="Model" />
        <button class="btn-primary" type="submit">Lưu sản phẩm</button>
        <a class="btn-ghost" asp-action="Index">Hủy</a>
    </form>
</div>
